# ─────────────────────────────────────────────────────────────────────────────
# Appwrite Web SDK configuration (public — safe to ship to the browser).
# These values point to the Frankfurt Appwrite Cloud project provisioned
# by `node setup-appwrite.js` (see project root).
# ─────────────────────────────────────────────────────────────────────────────
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a8bb200003e1fcd3d26
VITE_APPWRITE_DATABASE_ID=school_db
VITE_APPWRITE_BUCKET_ID=school_assets

# ─────────────────────────────────────────────────────────────────────────────
# Server-side provisioning key used ONLY by `setup-appwrite.js`.
# Never prefixed with VITE_ — Vite will not bundle it into client code.
# ─────────────────────────────────────────────────────────────────────────────
APPWRITE_API_KEY=standard_5baf5a8e01ac5e7eeba8bdf0b7f89c53a835b973f01168de5cc49c245b7c253f17eaa6f22f306e01feb314f3890653056c95c0a4844c02007f8b826803a7f9c9f39781de1f68fa4195126324d9090327f9d5948c64cbbbc3c05ce0b4ec117b4da09235a096c935833d6b1e4d7c84e72e08fe2851110a7c32d6972d580c4873ed
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a8bb200003e1fcd3d26

# Admin credentials (default account created on first run — CHANGE after login).
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=Admin@12345
