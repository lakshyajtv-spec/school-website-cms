{
  "database": { "id": "$VITE_APPWRITE_DATABASE_ID", "name": "School CMS" },
  "bucket": {
    "id": "$VITE_APPWRITE_BUCKET_ID",
    "name": "school-media",
    "fileSecurity": true,
    "maximumFileSize": 10485760,
    "allowedFileExtensions": ["jpg", "jpeg", "png", "webp", "gif", "svg"],
    "permissions": {
      "read": ["any"],
      "create": ["users"],
      "update": ["users"],
      "delete": ["users"]
    }
  },
  "collections": [
    "settings",
    "navigation",
    "hero",
    "about",
    "principal",
    "highlights",
    "teachers",
    "gallery",
    "notices",
    "facilities",
    "achievements",
    "vocational",
    "vocational_courses",
    "vocational_subjects",
    "vocational_certificates",
    "vocational_skills",
    "vocational_careers",
    "footer",
    "social_links"
  ],
  "collectionPermissions": {
    "documentSecurity": false,
    "read": ["any"],
    "create": ["users"],
    "update": ["users"],
    "delete": ["users"]
  },
  "commonAttributes": [
    { "key": "revision", "type": "string", "size": 36, "required": true },
    { "key": "lang", "type": "string", "size": 8, "required": true },
    { "key": "kind", "type": "string", "size": 32, "required": true },
    { "key": "payload", "type": "string", "size": 100000, "required": true },
    { "key": "sortOrder", "type": "integer", "required": true, "default": 0 }
  ],
  "indexes": [
    { "key": "revision_idx", "type": "key", "attributes": ["revision"] },
    { "key": "kind_lang_idx", "type": "key", "attributes": ["kind", "lang"] },
    { "key": "sort_idx", "type": "key", "attributes": ["sortOrder"] }
  ]
}